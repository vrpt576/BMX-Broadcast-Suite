# Track identity and overlay defaults
BBS_TRACK_NAME=Your BMX Track
BBS_DEFAULT_THEME=default
BBS_APP_HOST=0.0.0.0
BBS_APP_PORT=8000
BBS_PUBLIC_BASE_URL=http://localhost:8000
BBS_LOG_LEVEL=INFO
BBS_LOG_DIR=connector/logs
BBS_LOG_RETENTION_DAYS=14

# RaceManager SQL Server -- every track must supply its own values
BBS_SQL_HOST=localhost
BBS_SQL_INSTANCE=
BBS_SQL_PORT=1433
BBS_SQL_DATABASE=RACE
BBS_SQL_USER=bbs_connector
BBS_SQL_PASSWORD=replace-me
BBS_SQL_DRIVER=ODBC Driver 18 for SQL Server
BBS_SQL_ENCRYPT=true
BBS_SQL_TRUST_SERVER_CERTIFICATE=true
BBS_SQL_CONNECT_TIMEOUT=5
BBS_SQL_QUERY_TIMEOUT=10

BBS_CORS_ORIGINS=*
BBS_CURRENT_MOTO_STATE_FILE=data/current_moto.json
BBS_CURRENT_MOTO_DEFAULT=1
BBS_LINEUP_CACHE_FILE=data/last_known_lineup.json
