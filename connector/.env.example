# Track identity and overlay defaults
BBS_TRACK_NAME=Your BMX Track
BBS_DEFAULT_THEME=default
BBS_APP_HOST=127.0.0.1
BBS_APP_PORT=8000
BBS_PUBLIC_BASE_URL=http://localhost:8000
BBS_LOG_LEVEL=INFO
BBS_LOG_DIR=connector/logs
BBS_LOG_RETENTION_DAYS=14

# RaceManager SQL Server -- every track must supply its own values
BBS_SQL_HOST=localhost
BBS_SQL_INSTANCE=
BBS_SQL_PORT=1433
BBS_SQL_DATABASE=RACE
BBS_SQL_USER=bbs_connector
BBS_SQL_PASSWORD=replace-me
BBS_SQL_DRIVER=ODBC Driver 18 for SQL Server
BBS_SQL_ENCRYPT=true
BBS_SQL_TRUST_SERVER_CERTIFICATE=true
BBS_SQL_CONNECT_TIMEOUT=5
BBS_SQL_QUERY_TIMEOUT=10

# Leave blank for localhost-only browser origins. LAN origins must be explicit.
BBS_CORS_ORIGINS=
BBS_REMOTE_CONTROL_ENABLED=false
BBS_CONTROL_TOKEN=
BBS_REMOTE_ADMIN_ENABLED=false
BBS_ADMIN_TOKEN=
BBS_CURRENT_MOTO_STATE_FILE=data/current_moto.json
BBS_CURRENT_MOTO_DEFAULT=1
BBS_LINEUP_CACHE_FILE=data/last_known_lineup.json
BBS_RESULTS_CACHE_FILE=data/last_known_results.json
BBS_RESULTS_ROLL_STATE_FILE=data/results_roll.json
BBS_PHASE_OVERRIDE_FILE=data/race_phase_overrides.json
BBS_THEME_DIR=themes

# Optional Sqorz live timing -- off by default, none of this is secret.
# BBS_SQORZ_MODE is "internet" (public, no auth, ~30s refresh) or "lan" (the
# track's scoring computer). BBS_SQORZ_EVENT_ID/BBS_SQORZ_ORG_CODE only
# matter in internet mode; BBS_SQORZ_HOST/BBS_SQORZ_PORT only matter in lan
# mode. Leave BBS_SQORZ_POLL_SECONDS blank for a mode-aware default (10s
# internet, 2s LAN) -- an explicit value always overrides that default.
BBS_SQORZ_ENABLED=false
BBS_SQORZ_MODE=internet
BBS_SQORZ_EVENT_ID=
BBS_SQORZ_ORG_CODE=
BBS_SQORZ_HOST=
BBS_SQORZ_PORT=4343
BBS_SQORZ_POLL_SECONDS=
BBS_SQORZ_TIMEOUT_SECONDS=2
