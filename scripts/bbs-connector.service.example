[Unit]
Description=BMX Broadcast Suite Connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bbs
WorkingDirectory=/opt/bmx-broadcast-suite
EnvironmentFile=/opt/bmx-broadcast-suite/.env
ExecStart=/opt/bmx-broadcast-suite/.venv/bin/python -m uvicorn connector.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
